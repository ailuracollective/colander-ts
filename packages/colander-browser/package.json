{
  "name": "@ailura/colander-browser",
  "version": "0.1.0",
  "description": "Browser-side lifecycle client for the packed @ailura/colander core.",
  "keywords": [
    "browser",
    "colander",
    "forms",
    "webassembly"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "node ../../scripts/audit-package.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "check:fix": "pnpm run fmt && pnpm run lint -- --fix && pnpm run typecheck",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "pnpm run test:unit",
    "test:contract": "vitest run test/web-client.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@ailura/colander": "workspace:*",
    "@ailura/colander-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.3.4"
}
