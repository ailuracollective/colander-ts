# This example is a separate pnpm workspace with its own lockfile, but it lives in the same git
# repository as everything else, so the root .gitignore already covers dependencies and build
# output. This file only records what is specific to this example.

# Environment. `.env.example` is the one that is meant to be committed.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS noise.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
