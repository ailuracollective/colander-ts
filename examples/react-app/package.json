{
  "name": "react-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate && tsc -b && vite build",
    "check": "pnpm run fmt:check && pnpm run lint",
    "check:fix": "pnpm run fmt && pnpm run lint -- --fix",
    "check:generated": "colander check --components-dir src/components/colander --shell src/components/colander/shell",
    "dev": "vite",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "generate": "colander generate --components-dir src/components/colander --shell src/components/colander/shell",
    "lint": "vp lint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ssr": "vitest run src/ssr.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ailura/colander": "link:../../packages/colander",
    "@ailura/colander-browser": "link:../../packages/colander-browser",
    "@ailura/colander-client": "link:../../packages/colander-client",
    "@ailura/colander-compiler": "link:../../packages/colander-compiler",
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.3.4"
}
