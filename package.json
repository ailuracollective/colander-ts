{
  "name": "@ailuracode/colander",
  "version": "0.1.0",
  "description": "TypeScript bindings for the colander form core, over WebAssembly.",
  "keywords": [
    "colander",
    "forms",
    "json-schema",
    "validation",
    "webassembly"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "pack": "vp pack",
    "prepack": "vp run build:wasm && vp run pack",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tar": "7.5.22",
    "typescript": "^5.9.2",
    "vite-plus": "1.0.0-rc.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4"
}
